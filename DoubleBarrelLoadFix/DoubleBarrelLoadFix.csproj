<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>DoubleBarrelLoadFix</AssemblyName>
    <RootNamespace>DoubleBarrelLoadFix</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Game>D:\Steam\steamapps\common\TheLongDark</Game>
    <Interop>$(Game)\MelonLoader\Il2CppAssemblies</Interop>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(Game)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(Game)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(Game)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(Game)\MelonLoader\net6\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Interop)\*.dll" Exclude="$(Interop)\Il2CppSystem.Data.dll;$(Interop)\Il2CppNewtonsoft.Json.dll;$(Interop)\UnityEngine.TextCoreTextEngineModule.dll" Private="false" />
  </ItemGroup>
</Project>
